{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdw",
  "mainBinaryName": "mdw",
  "version": "0.1.0",
  "identifier": "dev.mdw.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "Live-preview Markdown editor",
    "longDescription": "mdw is a single-file Markdown editor with Obsidian-style live preview, Vim keybindings, tables, math, images and themes.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown", "mimeType": "text/markdown", "role": "Editor" }
    ],
    "linux": {
      "deb": { "desktopTemplate": "mdw.desktop" },
      "rpm": { "desktopTemplate": "mdw.desktop" }
    }
  }
}
